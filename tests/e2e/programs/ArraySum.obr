MODULE ArraySum;
IMPORT Out;
VAR
    a: ARRAY 5 OF INTEGER;
    i, sum: INTEGER;
BEGIN
    FOR i := 0 TO 4 DO
        a[i] := (i + 1) * 10
    END;
    sum := 0;
    FOR i := 0 TO 4 DO
        sum := sum + a[i]
    END;
    Out.Int(sum, 0);
    Out.Ln;
    Out.Int(a[2], 0);
    Out.Ln
END ArraySum.
