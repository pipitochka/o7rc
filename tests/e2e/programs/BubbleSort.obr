MODULE BubbleSort;
IMPORT Out;
VAR
    a: ARRAY 8 OF INTEGER;
    i, j, tmp, n: INTEGER;
BEGIN
    n := 8;
    a[0] := 64; a[1] := 34; a[2] := 25; a[3] := 12;
    a[4] := 22; a[5] := 11; a[6] := 90; a[7] := 1;

    FOR i := 0 TO n - 2 DO
        FOR j := 0 TO n - 2 - i DO
            IF a[j] > a[j + 1] THEN
                tmp := a[j];
                a[j] := a[j + 1];
                a[j + 1] := tmp
            END
        END
    END;

    FOR i := 0 TO n - 1 DO
        Out.Int(a[i], 0); Out.Ln
    END
END BubbleSort.
