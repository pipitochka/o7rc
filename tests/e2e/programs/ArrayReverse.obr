MODULE ArrayReverse;
IMPORT Out;
VAR
    a: ARRAY 6 OF INTEGER;
    i, tmp, n: INTEGER;
BEGIN
    n := 6;
    FOR i := 0 TO n - 1 DO
        a[i] := (i + 1) * 10
    END;

    FOR i := 0 TO n DIV 2 - 1 DO
        tmp := a[i];
        a[i] := a[n - 1 - i];
        a[n - 1 - i] := tmp
    END;

    FOR i := 0 TO n - 1 DO
        Out.Int(a[i], 0); Out.Ln
    END
END ArrayReverse.
