MODULE ReadArray;
IMPORT In, Out;
VAR
    a: ARRAY 10 OF INTEGER;
    n, i, sum: INTEGER;
BEGIN
    In.Open;
    In.Int(n);
    FOR i := 0 TO n - 1 DO
        In.Int(a[i])
    END;
    sum := 0;
    FOR i := 0 TO n - 1 DO
        sum := sum + a[i]
    END;
    Out.Int(sum, 0);
    Out.Ln;
    Out.Int(a[0], 0);
    Out.Ln;
    Out.Int(a[n - 1], 0);
    Out.Ln
END ReadArray.
